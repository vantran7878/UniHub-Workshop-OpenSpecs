{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "migrate": "node -r dotenv/config ../node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "migrate:down": "node -r dotenv/config ../node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations",
    "gen-keys": "tsx scripts/gen-keys.ts",
    "seed": "tsx scripts/seed.ts",
    "reconcile-payments": "tsx scripts/reconcile-payments.ts",
    "worker:notifications": "tsx src/modules/notifications/worker.ts",
    "worker:ai": "tsx src/modules/workshops/aiWorker.ts",
    "worker:csv-import": "tsx src/modules/users/csvImportWorker.ts",
    "lint": "echo \"(no lint yet)\""
  },
  "dependencies": {
    "amqplib": "^1.0.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jose": "^6.1.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "uuid": "^14.0.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^10.0.0",
    "node-pg-migrate": "^8.0.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
