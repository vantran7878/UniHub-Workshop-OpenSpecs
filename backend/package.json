{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "migrate": "node -r dotenv/config ../node_modules/node-pg-migrate/bin/node-pg-migrate.js up -m migrations",
    "migrate:down": "node -r dotenv/config ../node_modules/node-pg-migrate/bin/node-pg-migrate.js down -m migrations",
    "gen-keys": "tsx scripts/gen-keys.ts",
    "seed": "tsx scripts/seed.ts",
    "reconcile-payments": "tsx scripts/reconcile-payments.ts",
    "lint": "echo \"(no lint yet)\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "amqplib": "^1.0.3",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/amqplib": "^0.10.7",
    "node-pg-migrate": "^8.0.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}

