PORT=4000

# PostgreSQL
DATABASE_URL=postgres://unihub:unihub@localhost:5432/unihub

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Payment sandbox (same origin as backend — POST /sandbox/charge)
PAYMENT_GATEWAY_URL=http://localhost:4000/sandbox

# Auth keys (RS256)
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem

# Email (dev via MailHog)
EMAIL_FROM=noreply@unihub.local
SMTP_HOST=localhost
SMTP_PORT=1025

# Uploads / storage
PDF_UPLOAD_DIR=./uploads/pdf

# AI summary (stub by default)
AI_API_URL=http://localhost:9999
AI_API_KEY=changeme
AI_MODEL=gpt-4o-mini

