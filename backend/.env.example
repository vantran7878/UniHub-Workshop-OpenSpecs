# Server
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=unihub
DB_USER=unihub
DB_PASS=unihub

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_PRIVATE_KEY_PATH=certs/private.pem
JWT_PUBLIC_KEY_PATH=certs/public.pem
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
